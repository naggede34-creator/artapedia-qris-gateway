# ====== APP ======
# Di Vercel, PORT tidak perlu diisi
PORT=3000
# URL publik web kamu (tanpa slash di akhir), mis. https://artapedia.vercel.app
BASE_URL=http://localhost:3000
# String acak panjang untuk mengamankan cookie login
SESSION_SECRET=ganti_dengan_string_acak_panjang

# ====== DATABASE (WAJIB di Vercel) ======
# Buat database gratis di https://turso.tech (pilih region Singapore)
# Kosongkan jika jalan di VPS/lokal -> otomatis pakai file data/artapedia.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ====== CRON (WAJIB di Vercel) ======
# String acak min 12 karakter. Di cron-job.org panggil tiap 1 menit:
# {BASE_URL}/cron/tick?key=ISI_CRON_SECRET
CRON_SECRET=

# ====== SETUP ADMIN ======
# String acak min 12 karakter. Buka {BASE_URL}/setup-admin untuk membuat akun admin.
# Setelah admin jadi, boleh dikosongkan lagi supaya halaman itu terkunci.
ADMIN_SETUP_KEY=

# ====== ATLANTIC H2H ======
ATLANTIC_BASE_URL=https://atlantich2h.com
# JANGAN commit apikey asli ke git. Isi hanya di file .env
ATLANTIC_API_KEY=

# ====== TELEGRAM NOTIF ======
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID channel/grup/chat, contoh channel: @namachannel atau -100xxxxxxxxxx
TELEGRAM_CHAT_ID=

# ====== ATURAN BISNIS ======
DEPOSIT_MIN=2000
DEPOSIT_MAX=10000000
WITHDRAW_MIN=10000
WITHDRAW_FEE=2000
# Jam buka penarikan (WIB, format 24 jam)
WITHDRAW_OPEN_HOUR=8
WITHDRAW_CLOSE_HOUR=16
TIMEZONE=Asia/Jakarta
# Interval cek status otomatis (detik)
POLL_INTERVAL=20
