# ====== APP ======
PORT=3000
# URL publik web kamu (tanpa slash di akhir) - dipakai untuk OAuth callback
BASE_URL=http://localhost:3000
# String acak panjang untuk session & tanda tangan webhook
SESSION_SECRET=ganti_dengan_string_acak_panjang
# Email yang otomatis jadi admin (pisahkan koma)
ADMIN_EMAILS=admin@gmail.com

# ====== ATLANTIC H2H ======
ATLANTIC_BASE_URL=https://atlantich2h.com
# JANGAN commit apikey asli ke git. Isi hanya di file .env
ATLANTIC_API_KEY=

# ====== TELEGRAM NOTIF ======
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID channel/grup/chat, contoh channel: @namachannel atau -100xxxxxxxxxx
TELEGRAM_CHAT_ID=

# ====== LOGIN GOOGLE (opsional) ======
# Callback: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ====== LOGIN GITHUB (opsional) ======
# Callback: {BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ====== ATURAN BISNIS ======
DEPOSIT_MIN=2000
DEPOSIT_MAX=10000000
WITHDRAW_MIN=10000
WITHDRAW_FEE=2000
# Jam buka penarikan (WIB, format 24 jam)
WITHDRAW_OPEN_HOUR=8
WITHDRAW_CLOSE_HOUR=16
TIMEZONE=Asia/Jakarta
# Interval cek status otomatis (detik)
POLL_INTERVAL=20
