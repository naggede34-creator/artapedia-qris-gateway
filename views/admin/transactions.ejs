<%- include('../partials/header') %>
<main class="container">
  <div class="page-head"><h1 class="text-3d">TRANSAKSI</h1></div>
  <%- include('nav') %>
  <div class="panel"><span class="panel-tag">DEPOSIT / QRIS</span>
    <div class="table-wrap"><table>
      <thead><tr><th>ID</th><th>User</th><th>Sumber</th><th class="num">Nominal</th><th class="num">Fee</th><th class="num">Masuk</th><th>Status</th><th>Waktu</th></tr></thead>
      <tbody><% deps.forEach(function (d) { %><tr><td class="mono"><%= d.reff_id %><div class="hint">ATL: <%= d.atl_id %></div></td><td><%= d.username %></td><td><span class="badge <%= d.source %>"><%= d.source.toUpperCase() %></span></td><td class="num"><%= rupiah(d.nominal) %></td><td class="num"><%= rupiah(d.fee) %></td><td class="num"><%= rupiah(d.get_balance) %></td><td><span class="badge <%= d.status %>"><%= d.status.toUpperCase() %></span></td><td class="small"><%= d.created_at %></td></tr><% }) %></tbody>
    </table></div></div>
  <div class="panel" style="margin-top:30px"><span class="panel-tag">PENARIKAN</span>
    <div class="table-wrap"><table>
      <thead><tr><th>ID</th><th>User</th><th>Tujuan</th><th class="num">Nominal</th><th class="num">Admin</th><th>Status</th><th>Waktu</th></tr></thead>
      <tbody><% wds.forEach(function (w) { %><tr><td class="mono"><%= w.ref_id %><div class="hint">ATL: <%= w.atl_id || '-' %></div></td><td><%= w.username %></td><td class="small"><b><%= w.bank_code %></b> <%= w.account_number %><br><%= w.account_name %></td><td class="num"><%= rupiah(w.amount) %></td><td class="num"><%= rupiah(w.admin_fee) %></td><td><span class="badge <%= w.status %>"><%= w.status.toUpperCase() %></span><% if (w.note) { %><div class="hint"><%= w.note %></div><% } %></td><td class="small"><%= w.created_at %></td></tr><% }) %></tbody>
    </table></div></div>
</main>
<%- include('../partials/footer') %>
