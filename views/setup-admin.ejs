<%- include('partials/header') %>
<main class="container">
  <div class="auth-wrap">
    <div class="panel" data-tilt>
      <span class="panel-tag">BOSS MODE</span>
      <h1 class="text-3d center" style="font-size:2.4rem">SETUP ADMIN</h1>
      <% if (!enabled) { %>
        <div class="alert error"><b>TERKUNCI!</b>Isi <code class="inline">ADMIN_SETUP_KEY</code> (minimal 12 karakter) di Environment Variables, lalu redeploy.</div>
      <% } else { %>
        <p class="center small">Buat akun admin baru, atau jadikan nama yang sudah ada sebagai admin (kode akunnya akan dibuat ulang).</p>
        <% if (typeof error !== 'undefined' && error) { %><div class="alert error" style="margin-bottom:14px"><b>GAWAT!</b><%= error %></div><% } %>
        <form class="form" method="post" action="/setup-admin" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label for="key">KUNCI SETUP (ADMIN_SETUP_KEY)</label><input class="input" id="key" name="key" type="password" required></div>
          <div class="field"><label for="username">NAMA ADMIN</label><input class="input" id="username" name="username" value="<%= form.username || '' %>" required pattern="[a-zA-Z0-9_]{3,20}" maxlength="20"></div>
          <button class="btn red block" type="submit">👑 JADIKAN ADMIN</button>
        </form>
      <% } %>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
