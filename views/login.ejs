<%- include('partials/header') %>
<main class="container">
  <div class="auth-wrap">
    <%- include('partials/flash') %>
    <div class="panel" data-tilt>
      <span class="panel-tag">WELCOME BACK!</span>
      <h1 class="text-3d center" style="font-size:2.6rem">MASUK</h1>
      <% if (typeof error !== 'undefined' && error) { %><div class="alert error" style="margin-bottom:14px"><b>GAWAT!</b><%= error %></div><% } %>
      <form class="form" method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field"><label for="login">USERNAME / GMAIL</label><input class="input" id="login" name="login" value="<%= typeof login !== 'undefined' ? login : '' %>" required></div>
        <div class="field"><label for="password">PASSWORD</label><input class="input" id="password" name="password" type="password" required></div>
        <button class="btn block" type="submit">⚡ MASUK</button>
      </form>
      <%- include('partials/oauth') %>
      <p class="center small">Belum punya akun? <a href="/register">Daftar gratis</a></p>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
